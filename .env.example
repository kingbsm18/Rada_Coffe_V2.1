# Local development only. Copy to .env (git-ignored). Never commit real credentials.
POSTGRES_USER=rada
POSTGRES_PASSWORD=rada_dev_password
POSTGRES_DB=rada
POSTGRES_PORT=5432
API_PORT=8000

# Backend (prefix RADA_). Used by docker compose and by a locally run backend.
RADA_ENVIRONMENT=development
RADA_DATABASE_URL=postgresql+psycopg://rada:rada_dev_password@localhost:5432/rada
RADA_LOG_LEVEL=INFO
RADA_LOG_FORMAT=json
RADA_CORS_ORIGINS=["http://localhost:3000"]
RADA_EDGE_MAX_BATCH_SIZE=500
RADA_EDGE_MAX_BODY_BYTES=5242880
# Development-only edge device registry (JSON list). Store the SHA-256 of the key, never the key.
# Refused by the backend outside development/test. See README "Send a test edge event".
RADA_EDGE_DEV_DEVICES=
