# Copy to frontend/.env.local. Never put secrets in NEXT_PUBLIC_* variables.
# demo = explicit fixture mode (development only); api = live backend data, no fixtures.
NEXT_PUBLIC_DATA_PROVIDER=demo
NEXT_PUBLIC_RADA_API_URL=http://localhost:8000
NEXT_PUBLIC_RADA_API_VERSION=v1
NEXT_PUBLIC_RADA_API_TIMEOUT_MS=12000
NEXT_PUBLIC_RADA_AUTH_STRATEGY=http-only-cookie
NEXT_PUBLIC_RADA_REALTIME_ENABLED=false
NEXT_PUBLIC_RADA_CAMERA_STREAMS_ENABLED=false
